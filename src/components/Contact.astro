---
const email = 'preetiraghunath.work@gmail.com';
---

<section class="section contact" id="contact" data-screen-label="Work With Us">
  <div class="wrap">
    <div class="reveal"><div class="eyebrow">Work with us</div></div>
    <h2
      class="headline reveal"
      data-d="1"
      style="margin:0 0 clamp(22px,2.6vw,34px); max-width:60ch; font-size:clamp(16px,1.5vw,19px); line-height:1.62;"
    >
      Alchemystical is boutique by design. We take on a deliberately limited number of projects each season, so that
      you get the attention your work requires.
    </h2>
    <p class="contact-note reveal" data-d="2">
      To discuss your project and whether we are the right fit, <a class="email-link glint" href={`mailto:${email}`}
        >get in touch</a
      >. Tell us what you are working on, your timeline, and the kind of support you are looking for. We will respond
      within three working days.
    </p>
    <a class="email-link glint reveal" data-d="2" href={`mailto:${email}`}>{email}</a>
  </div>
</section>
